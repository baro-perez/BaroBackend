<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.20.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BaroBackend.Domain\BaroBackend.Domain.csproj" />
    <ProjectReference Include="..\BaroBackend.Infrastructure\BaroBackend.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Configuration\" />
  </ItemGroup>
  
  <ItemGroup>
    <Content
      Include="..\..\localdevdata\**" 
      Link="localdevdata\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" 
      Condition="'$(Configuration)' == 'Debug'" />
    <None 
      Include="..\..\localdevdata\**" 
      Link="localdevdata\%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest" 
      Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>
</Project>
